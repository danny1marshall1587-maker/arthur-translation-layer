{
  "app-id": "org.arthur.TranslationLayer",
  "runtime": "org.gnome.Platform",
  "runtime-version": "45",
  "sdk": "org.gnome.Sdk",
  "command": "arthur-control-center",
  "finish-args": [
    "--socket=wayland",
    "--socket=x11",
    "--device=dri",
    "--device=kvm",
    "--socket=pulseaudio",
    "--filesystem=xdg-run/pipewire-0",
    "--filesystem=host",
    "--share=ipc",
    "--share=network",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "modules": [
    {
      "name": "arthur-backend",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p build && cd build && cmake -DCMAKE_INSTALL_PREFIX=/app .. && make && make install"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "."
        },
        {
          "type": "git",
          "url": "https://github.com/steinbergmedia/vst3_pluginterfaces.git",
          "branch": "master",
          "dest": "vst3_headers/pluginterfaces"
        },
        {
          "type": "git",
          "url": "https://github.com/steinbergmedia/vst3_base.git",
          "branch": "master",
          "dest": "vst3_headers/base"
        }
      ]
    }
  ]
}
